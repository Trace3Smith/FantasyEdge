# Copy to .env.local for `vercel dev`. Never commit real secrets.

# Clerk (https://dashboard.clerk.com — use a Development instance locally)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Stripe (test mode locally)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_MONTHLY=price_xxx          # $5 / month recurring price
STRIPE_PRICE_ANNUAL=price_xxx           # $50 / year recurring price
STRIPE_WEBHOOK_SECRET=whsec_xxx         # from `stripe listen` locally

# App base URL for Stripe redirects
APP_URL=http://localhost:3000

# Reused by the draft assistant (already set in prod)
ANTHROPIC_API_KEY=sk-ant-xxx

# Upstash Redis (already provisioned via Vercel integration)
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...
