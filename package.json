{
  "name": "fantasyedge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:coach": "node scripts/verify-draft-coach.mjs",
    "test:draft": "node scripts/test-draft-ai.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:dvp": "node scripts/check-dvp.mjs",
    "check:espn-handler": "node --experimental-test-module-mocks scripts/check-espn-handler.mjs && node --experimental-test-module-mocks scripts/check-connected-foundation.mjs",
    "check:teams": "node scripts/check-teams.mjs",
    "check:autopilot": "node scripts/check-autopilot.mjs && node --experimental-test-module-mocks scripts/check-autopilot-entitlement.mjs",
    "check:preview-safety": "node scripts/check-preview-safety.mjs && node --experimental-test-module-mocks scripts/check-preview-credentials.mjs",
    "check:my-edge-browser": "node scripts/check-my-edge-browser.mjs",
    "check:my-edge": "node scripts/check-my-edge.mjs && node scripts/check-my-edge-recommendations.mjs && node scripts/check-my-edge-ui.mjs && node scripts/check-my-edge-navigation.mjs",
    "check:sport-readiness": "node scripts/check-sport-readiness.mjs && node scripts/check-authenticated-fixtures.mjs && node scripts/check-readonly-capture.mjs",
    "check:credentials": "node scripts/check-espn-credentials.mjs && node scripts/check-credential-migration.mjs",
    "check:espn": "node scripts/check-espn-fantasy.mjs && node scripts/check-mlb-positions.mjs",
    "check:league-config": "node scripts/check-league-config.mjs",
    "check:league-dna": "node --experimental-test-module-mocks scripts/check-league-dna.mjs",
    "capture:league-settings": "node scripts/capture-league-settings.mjs",
    "check:brackets": "node scripts/check-brackets.mjs cfbweek nfl bowl",
    "check:model": "node scripts/check-model.mjs && node --experimental-test-module-mocks scripts/check-cfb-sp-snapshots.mjs",
    "fit:nfl-model": "node scripts/fit-nfl-model.mjs",
    "check:credential-lifecycle": "node --experimental-test-module-mocks scripts/check-credential-lifecycle.mjs",
    "check:preview-lifecycle": "node --experimental-test-module-mocks scripts/check-preview-lifecycle.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^1.21.0",
    "@upstash/redis": "^1.38.0",
    "stripe": "^17.5.0"
  }
}
